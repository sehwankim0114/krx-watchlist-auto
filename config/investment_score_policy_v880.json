          "points": 0
        },
        {
          "when": "current<=0 and previous>0",
          "points": 0.5
        },
        {
          "when": "current>0 and previous<=0",
          "points": 5.5
        },
        {
          "when": "current>0 and previous>0 and yoy<-30",
          "points": 2
        },
        {
          "when": "current>0 and previous>0 and -30<=yoy<-10",
          "points": 3
        },
        {
          "when": "current>0 and previous>0 and -10<=yoy<10",
          "points": 4
        },
        {
          "when": "current>0 and previous>0 and 10<=yoy<30",
