{
  "version": "2026-09-13-v8.8.0-explicit-100-point-scoring-contract",
  "status": "APPROVED_DESIGN_NOT_PRODUCTION",
  "parent_score_policy_version": "2026-07-01-v6.0-score-policy",
  "design_basis": {
    "v6_weights_preserved": true,
    "calibration_source": "2026-09-13-v8.7.8-investment-score-calibration-evidence",
    "decision_matrix_source": "2026-09-13-v8.7.9-investment-score-policy-decision-matrix",
    "empirical_percentiles_are_thresholds": false,
    "legacy_market_score_rescaled": false
  },
  "area_max_points": {
    "financial": 30,
    "valuation": 20,
    "growth_value": 15,
    "price_position": 15,
    "liquidity_elasticity": 10,
    "supply_disclosure": 10
  },
  "global_rules": {
    "component_increment": 0.5,
    "component_clamp": "0..component_max",
    "total_score_range": "0..100",
    "missing_required_input": "LIMITED_NO_IMPUTATION",
    "score_total_when_limited": null,
    "request_time_price_failure": "DISPLAY_WHITE_CIRCLE_AND_DO_NOT_USE_STATIC_CURRENT_PRICE_FALLBACK",
    "request_time_price_retry_policy": [
      10,
      5,
      2
    ],
    "historical_metric_price_basis": "CONFIRMED_OFFICIAL_DAILY_CLOSE",
    "financial_sector_benchmark_tickers": [
      "1021",
      "1024",
      "1025"
    ],
    "financial_sector_neutral_policy": {
      "debt_ratio_points": 1.5,
      "operating_cash_flow_points": 2.0,
      "ev_ebitda_points": 2.0,
      "psr_points": 1.5,
      "net_cash_points": 1.0,
      "warning": "SECTOR_STRUCTURAL_NONCOMPARABILITY"
    },
    "final_score_bands": [
      {
        "min": 85,
        "max": 100,
        "label": "핵심추천 후보"
      },
      {
        "min": 75,
        "max": 84.9,
        "label": "추천 후보"
      },
      {
        "min": 65,
        "max": 74.9,
        "label": "관찰 후보"
      },
      {
        "min": 55,
        "max": 64.9,
        "label": "대기·중립"
      },
      {
        "min": 0,
        "max": 54.9,
        "label": "주의"
      }
    ],
    "recommendation_caps": [
      "supply_level=위험",
      "operating_loss_flag=true",
      "current_position_label=고점권과열",
      "trading_activity_label=매우부족",
      "basis_date_mismatch",
      "request_time_price_unavailable"
    ]
  },
  "source_formula_policies": {
    "three_year_revenue_growth": {
      "formula": "((annual_revenue_y0 / annual_revenue_y2) ** 0.5 - 1) * 100",
      "requires": [
        "annual_revenue_y0>0",
        "annual_revenue_y2>0"
      ],
      "stability_yoy": [
        "(annual_revenue_y0/annual_revenue_y1-1)*100",
        "(annual_revenue_y1/annual_revenue_y2-1)*100"
      ]
    },
    "three_year_operating_profit_growth": {
      "formula_when_all_positive": "((annual_operating_profit_y0 / annual_operating_profit_y2) ** 0.5 - 1) * 100",
      "turnaround_rule": "if y0>0 and either y1<=0 or y2<=0, classify TURNAROUND instead of CAGR",
      "loss_rule": "if y0<=0, score 0"
    },
    "operating_cash_flow_margin": {
      "formula": "operating_cash_flow_annual / annual_revenue_y0 * 100",
      "requires": [
        "annual_revenue_y0>0"
      ]
    },
    "core_debt": {
      "include": [
        "current_borrowings",
        "noncurrent_borrowings",
        "bonds"
      ],
      "exclude": [
        "lease_liabilities",
        "other_financial_liabilities"
      ],
      "matching_policy": "EXACT_VALIDATED_INTEREST_BEARING_CORE_DEBT_IDS_ONLY"
    },
    "net_cash": {
      "formula": "cash_and_cash_equivalents - core_debt",
      "normalization": "net_cash / market_cap * 100"
    },
    "ev_ebitda": {
      "enterprise_value": "market_cap + core_debt - cash_and_cash_equivalents",
      "ebitda": "annual_operating_profit_y0 + depreciation + amortization",
      "da_source_policy": [
        "ifrs-full_AdjustmentsForDepreciationExpense",
        "ifrs-full_AdjustmentsForAmortisationExpense"
      ],
      "da_rule": "exact IFRS account IDs only; duplicate conflicting values => LIMITED",
      "requires": [
        "ebitda>0"
      ]
    },
    "psr": {
      "formula": "market_cap / annual_revenue_y0",
      "requires": [
        "annual_revenue_y0>0"
      ]
    },
    "quarter_acceleration": {
      "annual_revenue_yoy": "(annual_revenue_y0/annual_revenue_y1-1)*100",
      "annual_operating_profit_yoy": "(annual_operating_profit_y0/annual_operating_profit_y1-1)*100 when denominator>0",
      "revenue_delta_pp": "q2_revenue_yoy_pct - annual_revenue_yoy",
      "operating_profit_delta_pp": "q2_operating_profit_yoy_pct - annual_operating_profit_yoy"
    }
  },
  "components": [
    {
      "area": "financial",
      "item": "매출 성장과 안정성",
      "max_points": 5,
      "inputs": [
        "revenue_yoy_pct",
        "annual_revenue_y0",
        "annual_revenue_y1",
        "annual_revenue_y2"
      ],
      "score_rule": {
        "recent_yoy_base": [
          {
            "when": "x < -20",
            "points": 0
          },
          {
            "when": "-20 <= x < -5",
            "points": 1
          },
          {
            "when": "-5 <= x < 5",
            "points": 2.5
          },
          {
            "when": "5 <= x < 15",
            "points": 4
          },
          {
            "when": "15 <= x < 30",
            "points": 5
          },
          {
            "when": "x >= 30",
            "points": 4.5
          }
        ],
        "stability_adjustment": [
          {
            "when": "both annual YoY >= 0",
            "delta": 0.5
          },
          {
            "when": "either annual YoY <= -15",
            "delta": -1.0
          },
          {
            "when": "both annual YoY < 0",
            "delta": -1.5
          }
        ]
      }
    },
    {
      "area": "financial",
      "item": "영업이익 성장과 흑자 여부",
      "max_points": 7,
